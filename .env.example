# Copy to .env for local runs. All values below are the defaults.
PORT=3000
# Set this to use Postgres (the durable store). Leave unset for the
# in-memory dev store, which loses data on restart.
# DATABASE_URL=postgres://logwatcher:logwatcher@localhost:5432/logwatcher
WINDOW_MINUTES=10
BASELINE_HOURS=1
SPIKE_MULTIPLIER=3
SPIKE_MIN_COUNT=5
NEW_SIGNATURE_LOOKBACK_HOURS=24
